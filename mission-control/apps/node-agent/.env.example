# Copia a .env (o define estas variables en el servicio). NO guardes secretos reales en el repositorio.
# El node-agent NO lee .env por sí mismo: cárgalo con tu gestor de servicio
# (EnvironmentFile= en systemd, EnvironmentVariables en launchd, `nssm set ... AppEnvironmentExtra`)
# o con `node --env-file=.env dist/main.js`.

# Obligatorio. Identificador del equipo, p. ej. win-principal, win-laptop-1, mac, nube.
MC_MACHINE_ID=win-principal
# Opcional (por defecto: hostname).
#MC_MACHINE_NAME=PC Principal

# URL del BFF. Si se omite, el agente corre en modo "solo local" y no envía latidos.
#MC_BFF_URL=http://192.168.1.10:3100
# Token compartido BFF <-> node-agent. Obligatorio si hay MC_BFF_URL; también protege las rutas del agente.
# Genera uno largo y aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MC_NODE_AGENT_TOKEN=

# Hermes
MC_HERMES_URL=http://127.0.0.1:8642
MC_HERMES_BIN=hermes

# Latido (segundos, mínimo 10)
MC_HEARTBEAT_SEC=30

# Servidor local del agente (por defecto solo loopback)
MC_NODE_AGENT_HOST=127.0.0.1
MC_NODE_AGENT_PORT=3400

# Disco a medir (por defecto C:\ en Windows, / en el resto)
#MC_DISK_PATH=D:\
# JSON con AllowedCommand[] (ver allowed-commands.example.json). Si se omite, lista integrada.
#MC_ALLOWED_COMMANDS_FILE=./allowed-commands.json
# Trabajos pesados simultáneos acordados para este equipo
MC_MAX_HEAVY_JOBS=1
