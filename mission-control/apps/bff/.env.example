# Mission Control BFF — variables de entorno (copia a .env y ajusta; nunca subas .env con valores reales)
# El BFF NO lee .env por sí mismo: usa `node --env-file=.env dist/main.js` o exporta las variables.

# demo = datos simulados y etiquetados | paperclip = datos reales de Paperclip
MC_BACKEND=demo
MC_PORT=3300
# Interfaz de escucha. Por defecto solo loopback; usa la IP de Tailscale si hace falta abrirlo a la red privada.
MC_HOST=127.0.0.1

# --- Backend paperclip ---
MC_PAPERCLIP_URL=http://127.0.0.1:3100
# Vacío en local_trusted por loopback; Bearer en instancias no locales
MC_PAPERCLIP_TOKEN=
# Si falta, se usa la primera empresa
MC_PAPERCLIP_COMPANY_ID=
# Obligatorio en modo paperclip para aceptar latidos de node-agent (sin él se rechazan con 401).
# Genera uno largo y aleatorio, p. ej.: openssl rand -hex 32
MC_NODE_AGENT_TOKEN=

# --- Datos propios ---
MC_DATA_DIR=./data
# Relativo a apps/bff
MC_CATALOG_PATH=../../packages/catalog/catalog
# Registro de elecciones (solo lectura)
MC_ELECTIONS_FILE=
# JSON con [{ "modelLabel": "...", "inputPerMTok": 0, "outputPerMTok": 0 }] para estimar consumo (si no hay precios guardados en Ajustes)
MC_MODEL_PRICES_FILE=
# Carpeta de la UI compilada (por defecto ../ui/dist relativo a apps/bff)
MC_STATIC_DIR=

# --- Gateways de Hermes por equipo (opcional) ---
# Id del secreto de Paperclip con la clave del API server de cada equipo. También se puede fijar con PUT /api/mc/settings
# ({ ..., "hermesSecretIds": { "win-laptop-1": "<id>" } }). Se guarda solo el ID, nunca la clave.
# MC_HERMES_SECRET_WIN_PRINCIPAL=
# MC_HERMES_SECRET_WIN_LAPTOP_1=
# MC_HERMES_SECRET_WIN_LAPTOP_2=
# MC_HERMES_SECRET_MAC=
# URL base del API server de Hermes de un equipo que aún no ha enviado latido (respaldo para crear agentes)
# MC_HERMES_URL_WIN_LAPTOP_1=https://win-laptop-1.tu-tailnet.ts.net
# URL del node-agent de un equipo, para reenviar comandos permitidos
# MC_NODE_AGENT_URL_WIN_LAPTOP_1=http://100.64.0.10:7788
