{
  "name": "@mc/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\" \"test/**/*.test.ts\"",
    "lint": "echo 'sin lint propio'",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@mc/contracts": "workspace:*",
    "@mc/catalog": "workspace:*",
    "@mc/paperclip-client": "workspace:*",
    "hono": "4.13.13",
    "@hono/node-server": "2.1.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.19.1",
    "tsx": "4.23.15"
  }
}
